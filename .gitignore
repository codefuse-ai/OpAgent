# ===================================================================
#                      Python .gitignore
#
#        一个全面的模板，适用于大多数Python项目。
#     可以根据你的具体需求（如框架、工具等）进行修改。
# ===================================================================

# 1. 字节码和缓存文件
# -------------------------------------------------------------------
# Python 在运行时生成的缓存文件。它们可以被重新生成，不应被版本控制。
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# 2. 虚拟环境
# -------------------------------------------------------------------
# 永远不要提交你的虚拟环境。它包含特定于你操作系统的包，
# 并且体积庞大。其他人应该通过 requirements.txt 或 pyproject.toml 来创建自己的环境。
.venv/
venv/
ENV/
# env/
.env/

# 3. 依赖和包管理缓存
# -------------------------------------------------------------------
# Pip, Poetry, Pipenv 等工具的缓存文件。
.pip-cache/
.pdm-cache/
pip-wheel-metadata/
.pdm.toml
.pdm-python
pdm.lock
poetry.lock

# 4. 构建、分发和打包
# -------------------------------------------------------------------
# 使用 setuptools, wheel, pyinstaller 等工具生成的文件。
# 这些是构建产物，而不是源代码。
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# PyInstaller
# 通常在构建可执行文件时生成
*.spec

# 5. IDE 和编辑器配置
# -------------------------------------------------------------------
# 这些文件通常包含个人偏好设置，不应在团队中共享。
# 如果团队需要共享某些配置（如 linter 设置），可以进行例外处理。

# PyCharm
.idea/

# VSCode
.vscode/*
# 如果你想共享 launch.json 或 settings.json，可以取消下面这几行的注释
#!.vscode/settings.json
#!.vscode/launch.json
#!.vscode/tasks.json

# Sublime Text
*.sublime-project
*.sublime-workspace

# 6. 测试、覆盖率和静态分析报告
# -------------------------------------------------------------------
# 这些报告是在运行测试或分析时动态生成的。
.pytest_cache/
.tox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
pytestdebug.log

# Mypy, Ruff, Pylint 等
.mypy_cache/
.ruff_cache/
.pylint.d/

# 7. 敏感信息和本地配置
# -------------------------------------------------------------------
# 绝对不能将 API 密钥、密码等敏感信息提交到 Git 仓库！
# 通常将它们存储在 .env 文件中，并提供一个 .env.example 作为模板。
.env
*.env
.env.*
!*.env.example
!*.env.template

# 8. 数据和日志文件
# -------------------------------------------------------------------
# 本地数据库、日志文件和下载的数据集不应被版本控制。
*.log
*.db
*.sqlite3
# 如果你的项目会下载大型数据集，也应该在这里添加

# 9. 操作系统生成的文件
# -------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# 10. Jupyter Notebook 检查点
# -------------------------------------------------------------------
# Jupyter Notebook 自身 (*.ipynb) 通常需要版本控制，但它的检查点不需要。
.ipynb_checkpoints

./Agent-R1/tmp/
*.png
./tmp/
./Agent-R1/nohup.out
ak.py
nohup.out

# ===== Open-source release safety rules =====
.claude/
.sumi/
.codex

outlog_*.log
tmp/
**/nohup.out
**/output.log

backup_files/
Agent-R1/backup_files/

Agent-R1/mock_config_v3.json
Agent-R1/utils/login_test.py
tools/test_webarena/
tools/dataset_prepare/*.csv
tools/dataset_prepare/*.json
tools/results/*.csv
tools/results/*.pdf
tools/dataset_prepare/domain_comparison_chart.pdf

**/.nfs*
# ===== End open-source release safety rules =====
start_claude.sh
